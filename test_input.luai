lokal nama = masukan("Masukkan nama: ")
lokal usia = io.masukan("Masukkan usia: ")
lokal kota = io.minta("Masukkan kota: ")
lokal hobi = io.tanya("Masukkan hobi: ")
lokal alamat = io.baca("Masukkan alamat: ")

cetak("--- Hasil Input Pengguna ---")
cetak("Nama   :", nama)
cetak("Usia   :", usia)
cetak("Kota   :", kota)
cetak("Hobi   :", hobi)
cetak("Alamat :", alamat)
