{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "--[[",
      "]]"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "`",
      "close": "`"
    },
    {
      "open": "[[",
      "close": "]]"
    },
    {
      "open": "--[[",
      "close": "]]"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ],
    [
      "[[",
      "]]"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\b(fungsi|jika|atau_jika|selain_itu|untuk|selama|ulang|lakukan)\\b",
    "decreaseIndentPattern": "^\\s*(selesai|atau_jika|selain_itu|sampai)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*--(?:#?region\\b.*)",
      "end": "^\\s*--(?:#?endregion\\b.*)"
    }
  }
}
