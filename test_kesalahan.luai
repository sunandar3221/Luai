-- Skrip Uji Coba Penanganan Kesalahan Ramah Pemula & Rekomendasi Typo
cetak("=== Uji Coba Penanganan Kesalahan Ramah Pemula & Rekomendasi Typo ===")

-- 1. Menguji rekomendasi typo pemanggilan fungsi global (contoh: cwtak -> cetak)
lokal s1, p1 = pcall_aman(fungsi()
    cwtak("Halo Luai")
selesai)
cetak("\n[1] Uji Typo Fungsi 'cwtak':")
cetak(p1)

-- 2. Menguji rekomendasi typo fungsi modul bawaan (contoh: panjng -> panjang)
lokal s2, p2 = pcall_aman(fungsi()
    lokal p = teks.panjng("Tes String")
selesai)
cetak("\n[2] Uji Typo Modul 'teks.panjng':")
cetak(p2)

-- 3. Menguji pengindeksan nilai nihil
lokal s3, p3 = pcall_aman(fungsi()
    lokal akun = nihil
    cetak(akun.saldo)
selesai)
cetak("\n[3] Uji Nil Indexing:")
cetak(p3)

-- 4. Menguji operasi matematika pada nilai nihil
lokal s4, p4 = pcall_aman(fungsi()
    lokal hitung = 50 + nihil
selesai)
cetak("\n[4] Uji Operasi Hitung Nil:")
cetak(p4)

-- 5. Menguji tipe argumen yang tidak valid
lokal s5, p5 = pcall_aman(fungsi()
    matematika.akar("bukan_angka")
selesai)
cetak("\n[5] Uji Tipe Argumen Salah:")
cetak(p5)

cetak("\n=== Selesai Seluruh Uji Coba ===")
